# Backend Environment Variables

# PostgreSQL connection string (tables are created automatically on startup)
DATABASE_URL=postgresql://edu_user:password@localhost:5432/education
# Set to true only for a managed database that requires TLS
DATABASE_SSL=false

# Add the demo school, users and questions when the database is empty
SEED_DEMO_DATA=false

# Server Port
PORT=5001

# JWT Secret Key (Generate a secure random string)
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long

# Node Environment
NODE_ENV=production

# Frontend URL (for CORS)
FRONTEND_URL=https://edu.nadanaloga.com

# Optional: File Upload Settings
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf
